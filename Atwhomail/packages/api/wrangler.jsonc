{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atwhomail-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mail-d1",
      "database_id": "1d02352f-9f40-4e06-a95f-95a781a84998",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL",
      "bucket_name": "mail-r2"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
  // Phase 11 加入：vars / secrets（JWT_SECRET 等，用 .dev.vars 與 wrangler secret put）
}
