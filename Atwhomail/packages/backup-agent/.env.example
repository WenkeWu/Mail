# AtWhoMail Backup Agent 設定範本 → 複製為 .env（.env 已 gitignore）

# Production API（Phase 13 起才會用到）
ATWHOMAIL_API_URL=https://atwhomail-api.ulhome.workers.dev
# rescue token（x-admin-token）；Phase 12 不需要，Phase 13 拉 /api/backup/changes 需要
ADMIN_TOKEN=

# 本機 PostgreSQL（安裝 PostgreSQL 17 時設定的 superuser 密碼）
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=atwhomail_backup

# 備份落地目錄（R2 鏡像；Phase 14 使用）
BACKUP_ROOT=D:\Mail\mail-backup

# 同步週期（毫秒）；metadata 建議 5–15 分鐘
SYNC_INTERVAL_MS=300000
# R2 → 磁碟 同步週期（毫秒）；預設 1 小時，0 = 每 tick
R2_SYNC_INTERVAL_MS=3600000
# 測試用：跑 N 次 tick 後自動結束（0/未設 = 永久執行）
BACKUP_MAX_TICKS=0

# ── Phase 15：Restore（離線腳本；僅手動執行） ──
# Cloudflare API（CF_API_TOKEN 未設時會讀 ~/.atwhomail-cf-token）
CF_ACCOUNT_ID=
CF_API_TOKEN=
# 目標 D1 / R2（--target=test|prod 會對應到這兩組 ID/名稱）
D1_PROD_ID=
D1_TEST_ID=
R2_PROD_BUCKET=mail-r2
R2_TEST_BUCKET=mail-r2-restore-test
# restore 前的事前快照目錄
SNAPSHOT_DIR=D:\Mail\mail-backup-snapshots
